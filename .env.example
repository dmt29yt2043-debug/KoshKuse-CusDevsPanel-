# --- веб ---
APP_BASE_URL=http://localhost:8210
# секрет в ссылке для команды: https://…/?key=<ACCESS_KEY>
ACCESS_KEY=
TIMEZONE=Europe/Moscow
# токен агента на Маке (Authorization: Bearer …)
AGENT_TOKEN=

# --- хранилище ---
DATA_DIR=./data
TAXONOMY_PATH=./config/taxonomy.yaml

# --- разбор ---
# подписка Claude: обычно пусто — CLI берёт вход из Связки ключей (`claude` → /login).
# Нужен только если агент работает вне сессии пользователя: `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
PARSE_MODEL=claude-sonnet-5-5
BATCH_MODEL=claude-opus-5-5

# --- очередь ---
JOB_LEASE_MINUTES=120
QUEUE_WARN_HOURS=24
AGENT_STALE_MINUTES=10

# --- агент на Маке (этап 3): тот же AGENT_TOKEN, что на сервере ---
AGENT_SERVER_URL=https://kk-voices.pulseup.me
PIPELINE_DIR=~/CusDev-Pipeline
AGENT_POLL_SECONDS=30
TRANSCRIBE_TIMEOUT_MINUTES=110

# --- Google Drive (этап 4, ARCHITECTURE.md Р4) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
INDEX_SPREADSHEET_ID=
